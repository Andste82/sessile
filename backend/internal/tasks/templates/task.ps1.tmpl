# Task bootstrap, written by sessile (PROJECT_PLAN.md §4.12.2) for task
# {{ps .ID}}. Rewritten on every start; each step skips what is already done.
# Every value below is quoted by sessile, and nothing here comes from a
# command line anyone typed.

$TaskDir = {{ps .Dir}}
Set-Location -LiteralPath $TaskDir
[Environment]::CurrentDirectory = $TaskDir

# PowerShell before 7.3 drops the double quotes inside native arguments;
# $q is how an argument keeps one on every version.
if ($PSVersionTable.PSVersion -ge [version]'7.3') {
	$PSNativeCommandArgumentPassing = 'Standard'
	$q = '"'
} else {
	$q = '\"'
}

function Say([string]$m) { Write-Host "sessile: $m" -ForegroundColor Cyan }
function Stay([string]$m) {
	Write-Host ''
	Write-Host "sessile: $m" -ForegroundColor Yellow
	Write-Host "You are in the task folder, $TaskDir."
	powershell -NoLogo -NoExit
	exit
}

# Connection, Git and agent environment: loaded, then removed from disk (§4.12.9).
if (Test-Path -LiteralPath '.env.json') {
	$vars = Get-Content -Raw -LiteralPath '.env.json' | ConvertFrom-Json
	foreach ($p in $vars.PSObject.Properties) {
		[Environment]::SetEnvironmentVariable($p.Name, [string]$p.Value, 'Process')
	}
	Remove-Item -LiteralPath '.env.json' -Force
}
{{- if .Repo}}

if (-not (Test-Path -LiteralPath 'repo\.git')) {
	if (-not (Get-Command git -ErrorAction SilentlyContinue)) { Stay 'git is not installed on this host (install Git for Windows).' }
	Say {{ps (print "cloning " .Repo.URL)}}
	git clone -- {{ps .Repo.URL}} repo
	if ($LASTEXITCODE -ne 0) { Stay 'git clone failed; see above.' }
{{- if .Repo.Ref}}
	git -C repo checkout {{ps .Repo.Ref}}
	if ($LASTEXITCODE -ne 0) { Stay {{ps (print "could not check out " .Repo.Ref)}} }
{{- end}}
}
{{- if .GitName}}
git -C repo config user.name {{ps .GitName}}
{{- end}}
{{- if .GitEmail}}
git -C repo config user.email {{ps .GitEmail}}
{{- end}}
{{- end}}

# Where the user-space installers put agents; after the user's own Path.
$env:Path = "$env:Path;$env:USERPROFILE\.local\bin"
if (-not (Get-Command {{ps .Agent}} -ErrorAction SilentlyContinue)) {
{{- if .InstallPS}}
	Say {{ps (print "installing " .Agent " for this user")}}
	{{.InstallPS}}
	$env:Path = [Environment]::GetEnvironmentVariable('Path', 'User') + ";$env:Path"
	if (-not (Get-Command {{ps .Agent}} -ErrorAction SilentlyContinue)) { Stay {{ps (print "installing " .Agent " failed; see above.")}} }
{{- else}}
	Stay {{ps (print .Agent " is not installed on this host.")}}
{{- end}}
}

if (Test-Path -LiteralPath '.agent-started') {
	Say {{ps (print "resuming " .Agent)}}
	$started = Get-Date
	& {{psargv .Resume}}
	# A resume that fails straight away found nothing to resume (the history is
	# gone): start a new conversation in the same folder instead.
	if ($LASTEXITCODE -ne 0 -and ((Get-Date) - $started).TotalSeconds -lt 10) {
		Say {{ps (print "nothing to resume; starting " .Agent " again")}}
		& {{psargv .First}}
	}
} else {
	New-Item -ItemType File -Path '.agent-started' -Force | Out-Null
	Say {{ps (print "starting " .Agent)}}
	& {{psargv .First}}
}

Stay {{ps (print .Agent " has exited.")}}

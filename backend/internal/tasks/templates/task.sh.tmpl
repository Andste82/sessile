#!/bin/sh
# Task bootstrap, written by sessile (PROJECT_PLAN.md §4.12.2) for task
# {{q .ID}}. Rewritten on every start; each step skips what is already done.
# Every value below is quoted by sessile, and nothing here comes from a
# command line anyone typed.

TASK_DIR={{q .Dir}}
cd "$TASK_DIR" || exit 1

say() { printf '\033[36msessile: %s\033[0m\n' "$1"; }
stay() {
	printf '\n\033[33msessile: %s\033[0m\n' "$1"
	printf 'You are in the task folder, %s.\n' "$TASK_DIR"
	exec "${SHELL:-/bin/sh}" -l
}

# Connection, Git and agent environment: loaded, then removed from disk (§4.12.9).
if [ -f .env ]; then
	set -a
	. ./.env
	set +a
	rm -f .env
fi
{{- if .Repo}}

if [ ! -d repo/.git ]; then
	command -v git >/dev/null 2>&1 || stay "git is not installed on this host."
	say {{q (print "cloning " .Repo.URL)}}
	git clone -- {{q .Repo.URL}} repo || stay "git clone failed; see above."
{{- if .Repo.Ref}}
	git -C repo checkout {{q .Repo.Ref}} || stay {{q (print "could not check out " .Repo.Ref)}}
{{- end}}
fi
{{- if .GitName}}
git -C repo config user.name {{q .GitName}}
{{- end}}
{{- if .GitEmail}}
git -C repo config user.email {{q .GitEmail}}
{{- end}}
{{- end}}

# Where the user-space installers put agents; after the user's own PATH.
export PATH="$PATH:$HOME/.local/bin"
if ! command -v {{q .Agent}} >/dev/null 2>&1; then
{{- if .Install}}
	say {{q (print "installing " .Agent " for this user")}}
	{{.Install}} || stay {{q (print "installing " .Agent " failed; see above.")}}
	command -v {{q .Agent}} >/dev/null 2>&1 || stay {{q (print .Agent " was installed but isn't on PATH.")}}
{{- else}}
	stay {{q (print .Agent " is not installed on this host.")}}
{{- end}}
fi

if [ -f .agent-started ]; then
	say {{q (print "resuming " .Agent)}}
	started=$(date +%s)
	{{argv .Resume}}
	status=$?
	# A resume that fails straight away found nothing to resume (the history is
	# gone): start a new conversation in the same folder instead.
	if [ "$status" -ne 0 ] && [ $(( $(date +%s) - started )) -lt 10 ]; then
		say {{q (print "nothing to resume; starting " .Agent " again")}}
		{{argv .First}}
	fi
else
	touch .agent-started
	say {{q (print "starting " .Agent)}}
	{{argv .First}}
fi

stay {{q (print .Agent " has exited.")}}

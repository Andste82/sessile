# Task bootstrap, written by sessile (PROJECT_PLAN.md §4.12.2) for task
# 'dbg-142-print-crash-3f9a1c'. Rewritten on every start; each step skips what is already done.
# Every value below is quoted by sessile, and nothing here comes from a
# command line anyone typed.

$TaskDir = 'C:\Users\ob\.sessile\tasks\dbg-142-print-crash-3f9a1c'
Set-Location -LiteralPath $TaskDir
[Environment]::CurrentDirectory = $TaskDir

# PowerShell before 7.3 drops the double quotes inside native arguments;
# $q is how an argument keeps one on every version.
if ($PSVersionTable.PSVersion -ge [version]'7.3') {
	$PSNativeCommandArgumentPassing = 'Standard'
	$q = '"'
} else {
	$q = '\"'
}

function Say([string]$m) { Write-Host "sessile: $m" -ForegroundColor Cyan }
function Stay([string]$m) {
	Remove-Item -LiteralPath '.env.json', '.env' -Force -ErrorAction SilentlyContinue
	Write-Host ''
	Write-Host "sessile: $m" -ForegroundColor Yellow
	Write-Host "You are in the task folder, $TaskDir."
	powershell -NoLogo -NoExit
	exit
}

# Connection, Git and agent environment: loaded, then removed from disk (§4.12.9).
if (Test-Path -LiteralPath '.env.json') {
	$vars = Get-Content -Raw -LiteralPath '.env.json' | ConvertFrom-Json
	foreach ($p in $vars.PSObject.Properties) {
		[Environment]::SetEnvironmentVariable($p.Name, [string]$p.Value, 'Process')
	}
	Remove-Item -LiteralPath '.env.json' -Force
}

if (-not (Test-Path -LiteralPath 'repo\.git')) {
	if (-not (Get-Command git -ErrorAction SilentlyContinue)) { Stay 'git is not installed on this host (install Git for Windows).' }
	Say 'cloning https://github.com/moonlight-stream/moonlight-android'
	git clone -- 'https://github.com/moonlight-stream/moonlight-android' repo
	if ($LASTEXITCODE -ne 0) { Stay 'git clone failed; see above.' }
	git -C repo checkout 'main'
	if ($LASTEXITCODE -ne 0) { Stay 'could not check out main' }
}

# The devcontainer (§4.12.3): used through the host's own CLI (Docker
# Desktop), with a fixed set of mounts. Inside it the agent runs from
# agent.sh, which loads and deletes the POSIX .env.
if (-not (Get-Command devcontainer -ErrorAction SilentlyContinue)) { Stay 'the devcontainer CLI is not installed on this host (npm install -g @devcontainers/cli).' }
$dcConfig = $null
$hasConfig = (Test-Path -LiteralPath 'repo\.devcontainer\devcontainer.json') -or (Test-Path -LiteralPath 'repo\.devcontainer.json') -or
	[bool](Get-ChildItem -Path 'repo\.devcontainer\*\devcontainer.json' -ErrorAction SilentlyContinue)
if (-not $hasConfig) {
	Stay 'the repo has no devcontainer config (.devcontainer\devcontainer.json).'
}
$up = @('up', '--workspace-folder', (Join-Path $TaskDir 'repo'), '--mount', "type=bind,source=$TaskDir,target=/sessile/task")
if ($dcConfig) { $up += @('--config', $dcConfig) }
if (Test-Path -LiteralPath '.rebuild-container') {
	Remove-Item -LiteralPath '.rebuild-container' -Force
	$up += '--remove-existing-container'
}
Say 'starting the devcontainer'
& devcontainer @up
if ($LASTEXITCODE -ne 0) { Stay 'devcontainer up failed; see above.' }
$exec = @('exec', '--workspace-folder', (Join-Path $TaskDir 'repo'))
if ($dcConfig) { $exec += @('--config', $dcConfig) }
& devcontainer @exec --remote-env SESSILE_IN_CONTAINER=1 sh /sessile/task/agent.sh
Remove-Item -LiteralPath '.env' -Force -ErrorAction SilentlyContinue
exit

# Where the user-space installers put agents; after the user's own Path.
$env:Path = "$env:Path;$env:USERPROFILE\.local\bin"
if (-not (Get-Command 'claude' -ErrorAction SilentlyContinue)) {
	Stay 'claude is not installed on this host.'
}

if (Test-Path -LiteralPath '.restart-fresh') {
	Remove-Item -LiteralPath '.restart-fresh', '.agent-started' -Force -ErrorAction SilentlyContinue
}

if (Test-Path -LiteralPath '.agent-started') {
	Say 'resuming claude'
	$started = Get-Date
	& 'claude' '--continue' '--permission-mode' 'plan'
	# A resume that fails straight away found nothing to resume (the history is
	# gone): start a new conversation in the same folder instead.
	if ($LASTEXITCODE -ne 0 -and ((Get-Date) - $started).TotalSeconds -lt 10) {
		Say 'nothing to resume; starting claude again'
		& 'claude' '--permission-mode' 'plan' 'Read PROMPT.md: that''s my request.'
	}
} else {
	New-Item -ItemType File -Path '.agent-started' -Force | Out-Null
	Say 'starting claude'
	& 'claude' '--permission-mode' 'plan' 'Read PROMPT.md: that''s my request.'
}

Stay 'claude has exited.'

#!/bin/sh
# Task bootstrap, written by sessile (PROJECT_PLAN.md §4.12.2) for task
# 'dbg-142-print-crash-3f9a1c'. Rewritten on every start; each step skips what is already done.
# Every value below is quoted by sessile, and nothing here comes from a
# command line anyone typed.

TASK_DIR='/home/ob/.sessile/tasks/dbg-142-print-crash-3f9a1c'
cd "$TASK_DIR" || exit 1

say() { printf '\033[36msessile: %s\033[0m\n' "$1"; }
stay() {
	rm -f .env
	printf '\n\033[33msessile: %s\033[0m\n' "$1"
	printf 'You are in the task folder, %s.\n' "$TASK_DIR"
	exec "${SHELL:-/bin/sh}" -l
}

# Connection, Git and agent environment for the clone below. agent.sh loads
# it again where the agent runs and deletes it (§4.12.9).
if [ -f .env ]; then
	set -a
	. ./.env
	set +a
fi

if [ ! -d repo/.git ]; then
	command -v git >/dev/null 2>&1 || stay "git is not installed on this host."
	say 'cloning https://github.com/moonlight-stream/moonlight-android'
	git clone -- 'https://github.com/moonlight-stream/moonlight-android' repo || stay "git clone failed; see above."
	git -C repo checkout 'main' || stay 'could not check out main'
fi

# The devcontainer (§4.12.3): used through the host's own CLI, with a fixed
# set of mounts. The task folder is /sessile/task inside it.
command -v devcontainer >/dev/null 2>&1 || stay "the devcontainer CLI is not installed on this host (npm install -g @devcontainers/cli)."
command -v docker >/dev/null 2>&1 || stay "docker is not installed on this host."
DC_CONFIG=
if [ ! -f repo/.devcontainer/devcontainer.json ] && [ ! -f repo/.devcontainer.json ] &&
	[ -z "$(ls repo/.devcontainer/*/devcontainer.json 2>/dev/null)" ]; then
	say "the repo has no devcontainer config; using sessile's generic one"
	DC_CONFIG="$TASK_DIR/.devcontainer-generic/devcontainer.json"
fi
set -- up --workspace-folder "$TASK_DIR/repo" --mount "type=bind,source=$TASK_DIR,target=/sessile/task"
set -- "$@" --mount "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock"
if [ -n "$DC_CONFIG" ]; then set -- "$@" --config "$DC_CONFIG"; fi
if [ -f .rebuild-container ]; then
	rm -f .rebuild-container
	set -- "$@" --remove-existing-container
fi
say "starting the devcontainer"
devcontainer "$@" || stay "devcontainer up failed; see above."

set -- exec --workspace-folder "$TASK_DIR/repo"
if [ -n "$DC_CONFIG" ]; then set -- "$@" --config "$DC_CONFIG"; fi
exec devcontainer "$@" --remote-env SESSILE_IN_CONTAINER=1 sh /sessile/task/agent.sh

#!/bin/sh
# Starts the task's agent (PROJECT_PLAN.md §4.12.4), on the host or inside
# the task's devcontainer. Written by sessile for task 'dbg-142-print-crash-3f9a1c'.

if [ -n "$SESSILE_IN_CONTAINER" ]; then
	TASK_DIR=/sessile/task
else
	TASK_DIR='/home/ob/.sessile/tasks/dbg-142-print-crash-3f9a1c'
fi
cd "$TASK_DIR" || exit 1

say() { printf '\033[36msessile: %s\033[0m\n' "$1"; }
stay() {
	rm -f .env
	printf '\n\033[33msessile: %s\033[0m\n' "$1"
	printf 'You are in the task folder, %s.\n' "$TASK_DIR"
	exec "${SHELL:-/bin/sh}" -l
}

# Connection, Git and agent environment: loaded, then removed from disk (§4.12.9).
if [ -f .env ]; then
	set -a
	. ./.env
	set +a
	rm -f .env
fi

if [ -n "$SESSILE_IN_CONTAINER" ]; then
	# Inside the container everything sessile brings lives in the task folder,
	# whoever the container's user is (§4.12.3): the agent install survives a
	# rebuild, and so does its history, which is what makes resume work.
	export PATH="$PATH:$TASK_DIR/.tools/bin:$TASK_DIR/.tools/home/.local/bin:$HOME/.local/bin"
	export CLAUDE_CONFIG_DIR="$TASK_DIR/.agent/claude"
	export CODEX_HOME="$TASK_DIR/.agent/codex"
	export GEMINI_CLI_HOME="$TASK_DIR/.agent/gemini"
	mkdir -p "$CLAUDE_CONFIG_DIR" "$CODEX_HOME" "$GEMINI_CLI_HOME"
	if [ "$(id -u)" = 0 ]; then
		say "this container runs as root: files it creates in the repo will be owned by root on the host"
	fi
else
	# Where the user-space installers put agents; after the user's own PATH.
	export PATH="$PATH:$HOME/.local/bin"
fi

if ! command -v 'claude' >/dev/null 2>&1; then
	say 'installing claude'
	command -v curl >/dev/null 2>&1 || stay "installing claude needs curl."
	mkdir -p "$TASK_DIR/.tools/home"
	curl -fsSL https://claude.ai/install.sh | HOME="$TASK_DIR/.tools/home" bash || stay 'installing claude failed; see above.'
	command -v 'claude' >/dev/null 2>&1 || stay 'claude was installed but isn'\''t on PATH.'
fi

if [ -f .restart-fresh ]; then
	rm -f .restart-fresh .agent-started
fi

if [ -f .agent-started ]; then
	say 'resuming claude'
	started=$(date +%s)
	'claude' '--continue' '--permission-mode' 'plan'
	status=$?
	# A resume that fails straight away found nothing to resume (the history is
	# gone): start a new conversation in the same folder instead.
	if [ "$status" -ne 0 ] && [ $(( $(date +%s) - started )) -lt 10 ]; then
		say 'nothing to resume; starting claude again'
		'claude' '--permission-mode' 'plan' 'Read PROMPT.md: that'\''s my request.'
	fi
else
	touch .agent-started
	say 'starting claude'
	'claude' '--permission-mode' 'plan' 'Read PROMPT.md: that'\''s my request.'
fi

stay 'claude has exited.'
